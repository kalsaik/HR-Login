<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Record-level security rules for portal users.

        These rules add a second layer of defence on top of the sudo() pattern
        used in controllers. Even if a bug bypassed the controller checks, the
        ORM would still prevent a portal user from reading another employee's
        leave records.

        Both rules are GLOBAL (no group_id) but include a portal-user domain
        condition, so they only activate when the current user is a portal user.
    -->

    <!-- Portal users may only read their own hr.leave records -->
    <record id="hr_leave_rule_portal" model="ir.rule">
        <field name="name">HR Leave: portal users see own records only</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="domain_force">
            ['|',
                ('employee_id.user_id', '=', user.id),
                ('employee_id', '=', False)
            ]
        </field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Portal users may only read their own hr.leave.allocation records -->
    <record id="hr_leave_allocation_rule_portal" model="ir.rule">
        <field name="name">HR Leave Allocation: portal users see own records only</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave_allocation"/>
        <field name="domain_force">
            ['|',
                ('employee_id.user_id', '=', user.id),
                ('employee_id', '=', False)
            ]
        </field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>


    <!-- Portal users may only read/create their own attendance adjustment requests -->
    <record id="hr_attendance_adjustment_rule_portal" model="ir.rule">
        <field name="name">Attendance Adjustment: portal users see own records only</field>
        <field name="model_id" ref="hr_holidays_portal.model_hr_attendance_adjustment"/>
        <field name="domain_force">
            [('employee_id.user_id', '=', user.id)]
        </field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="False"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
