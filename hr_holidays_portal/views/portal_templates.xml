<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== Portal Home: HR Self-Service app grid ===== -->
    <template id="portal_my_home_allocations"
              name="Portal My Home: HR Self-Service"
              inherit_id="portal.portal_my_home">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <div class="mb-5">
                <p class="hr-section-label">HR Self-Service</p>
                <div class="row g-3">
                    <div class="col-4 col-sm-3 col-md-2">
                        <a href="/my/allocations" class="text-decoration-none d-block h-100">
                            <div class="hr-app-card">
                                <div class="hr-app-icon-bg">
                                    <i class="fa fa-calendar"/>
                                </div>
                                <span class="hr-app-label">Leave</span>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <!-- ===== /my/allocations — main Leave page ===== -->
    <template id="portal_my_allocations" name="My Leave Allocations">
        <t t-call="portal.portal_layout">
            <div class="hr-page">

                <!-- Success banner -->
                <t t-if="success">
                    <div class="hr-alert hr-alert-success">
                        <i class="fa fa-check-circle"/>
                        Your leave request has been submitted and is pending approval.
                    </div>
                </t>

                <!-- Greeting Banner -->
                <div class="hr-banner">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h3>Hi, <t t-esc="employee.name.split()[0] if employee else 'there'"/>!</h3>
                            <p class="hr-banner-sub">
                                <t t-if="employee and employee.job_title">
                                    <t t-esc="employee.job_title"/>
                                </t>
                                <t t-elif="employee and employee.department_id">
                                    <t t-esc="employee.department_id.name"/>
                                </t>
                                <t t-else="">Employee</t>
                            </p>
                        </div>
                        <t t-if="employee">
                            <div class="hr-banner-avatar">
                                <t t-esc="employee.name[0:1].upper()"/>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- Leave Balances -->
                <div class="hr-section-hd">
                    <span class="hr-section-hd-title">Leave Balances</span>
                    <span class="hr-section-hd-sub">Days remaining</span>
                </div>
                <div class="hr-card">
                    <t t-if="not employee or not allocations">
                        <div class="hr-empty">
                            <i class="fa fa-clipboard-o"/>
                            <p class="hr-empty-title">No allocations found</p>
                            <p class="hr-empty-sub">Contact HR to set up your leave entitlements.</p>
                        </div>
                    </t>
                    <t t-if="allocations">
                        <div class="row g-2">
                            <t t-foreach="allocations" t-as="alloc">
                                <t t-set="remaining"
                                   t-value="alloc.number_of_days - alloc.leaves_taken"/>
                                <t t-set="pending_days"
                                   t-value="pending_by_type.get(alloc.holiday_status_id.id, 0)"/>
                                <div class="col-6 col-sm-4">
                                    <div class="hr-alloc-block"
                                         t-att-title="alloc.holiday_status_id.name">
                                        <div class="hr-alloc-name">
                                            <t t-esc="alloc.holiday_status_id.name"/>
                                        </div>
                                        <div class="hr-alloc-days">
                                            <t t-esc="'%.0f' % remaining"/>
                                        </div>
                                        <div class="hr-alloc-unit">days</div>
                                        <div class="hr-alloc-sub">
                                            <span class="p">
                                                <t t-esc="'%.0f' % pending_days"/> pending
                                            </span>
                                            <span class="hr-alloc-sep">·</span>
                                            <span class="u">
                                                <t t-esc="'%.0f' % alloc.leaves_taken"/> used
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </t>
                </div>

                <!-- Request Leave button -->
                <a href="/my/leaves/new" class="hr-btn-request">
                    + Request Leave
                </a>

                <!-- Recent Requests -->
                <div class="hr-section-hd">
                    <span class="hr-section-hd-title">Recent Requests</span>
                    <a href="#" class="hr-section-hd-sub">View all →</a>
                </div>
                <div class="hr-card">
                    <t t-if="not recent_leaves">
                        <div class="hr-empty">
                            <i class="fa fa-inbox"/>
                            <p class="hr-empty-title">No requests yet</p>
                            <p class="hr-empty-sub">
                                Tap <strong>Request Leave</strong> above to submit your first request.
                            </p>
                        </div>
                    </t>
                    <t t-if="recent_leaves">
                        <t t-foreach="recent_leaves" t-as="leave">
                            <div class="hr-leave-row">
                                <div class="flex-grow-1 me-3 overflow-hidden">
                                    <div class="hr-leave-type-name text-truncate">
                                        <t t-esc="leave.holiday_status_id.name"/>
                                    </div>
                                    <div class="hr-leave-meta">
                                        <t t-esc="leave.date_from" t-options='{"widget":"date"}'/>
                                        <span class="mx-1">→</span>
                                        <t t-esc="leave.date_to"   t-options='{"widget":"date"}'/>
                                        <span class="ms-1">
                                            (<t t-esc="'%.0f' % leave.number_of_days"/>d)
                                        </span>
                                    </div>
                                </div>
                                <div class="flex-shrink-0">
                                    <t t-if="leave.state == 'validate'">
                                        <span class="hr-badge hr-badge-approved">Approved</span>
                                    </t>
                                    <t t-elif="leave.state in ('confirm', 'validate1')">
                                        <span class="hr-badge hr-badge-pending">Pending</span>
                                    </t>
                                    <t t-elif="leave.state == 'refuse'">
                                        <span class="hr-badge hr-badge-refused">Refused</span>
                                    </t>
                                    <t t-else="">
                                        <span class="hr-badge hr-badge-draft">Draft</span>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </t>
                </div>

            </div>
        </t>
    </template>

    <!-- ===== /my/leaves/new — Leave Request Form ===== -->
    <template id="portal_leave_new" name="New Leave Request">
        <t t-call="portal.portal_layout">
            <div class="hr-page">

                <!-- Banner with back link -->
                <div class="hr-banner">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <a href="/my/allocations" class="hr-banner-back">
                                <i class="fa fa-arrow-left me-1"/>Back to Leave
                            </a>
                            <h3 class="mb-0">New Leave Request</h3>
                        </div>
                        <t t-if="employee">
                            <div class="hr-banner-avatar">
                                <t t-esc="employee.name[0:1].upper()"/>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- Error banner -->
                <t t-if="error">
                    <div class="hr-alert hr-alert-error">
                        <i class="fa fa-exclamation-circle"/>
                        <t t-esc="error"/>
                    </div>
                </t>

                <!-- No leave types available -->
                <t t-if="not leave_types_data">
                    <div class="hr-card">
                        <div class="hr-empty">
                            <i class="fa fa-clipboard-o"/>
                            <p class="hr-empty-title">No leave types available</p>
                            <p class="hr-empty-sub">
                                You don't have any approved allocations. Please contact HR.
                            </p>
                        </div>
                    </div>
                    <a href="/my/allocations" class="hr-btn-request">
                        Back to Leave Overview
                    </a>
                </t>

                <!-- Request form -->
                <t t-if="leave_types_data">

                    <!-- Pass values to JS -->
                    <t t-set="sl_id_str"   t-value="str(sick_leave_id)"/>
                    <t t-set="cert_thresh" t-value="str(cert_threshold)"/>

                    <div class="hr-card">
                        <form method="post" action="/my/leaves/new"
                              enctype="multipart/form-data">
                            <input type="hidden" name="csrf_token"
                                   t-att-value="request.csrf_token()"/>

                            <!-- Leave Type -->
                            <div class="hr-form-group">
                                <label class="hr-form-label" for="leave_type_id">
                                    Leave Type <span class="required">*</span>
                                </label>
                                <select name="leave_type_id" id="leave_type_id"
                                        class="hr-form-control hr-form-select"
                                        required="required">
                                    <option value="">— Select leave type —</option>
                                    <t t-foreach="leave_types_data" t-as="lt">
                                        <option t-att-value="lt['id']"
                                                t-att-selected="form_leave_type_id == lt['id']">
                                            <t t-esc="lt['name']"/>
                                            (<t t-esc="'%.1f' % lt['remaining']"/> days remaining)
                                        </option>
                                    </t>
                                </select>
                            </div>

                            <!-- Date range -->
                            <div class="row g-3 mb-4">
                                <div class="col-6">
                                    <div class="hr-form-group mb-0">
                                        <label class="hr-form-label" for="date_from">
                                            From <span class="required">*</span>
                                        </label>
                                        <input type="date" name="date_from" id="date_from"
                                               class="hr-form-control"
                                               t-att-value="form_date_from"
                                               required="required"/>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="hr-form-group mb-0">
                                        <label class="hr-form-label" for="date_to">
                                            To <span class="required">*</span>
                                        </label>
                                        <input type="date" name="date_to" id="date_to"
                                               class="hr-form-control"
                                               t-att-value="form_date_to"
                                               required="required"/>
                                    </div>
                                </div>
                            </div>

                            <!-- Reason -->
                            <div class="hr-form-group">
                                <label class="hr-form-label" for="reason">
                                    Reason <span class="optional">(optional)</span>
                                </label>
                                <textarea name="reason" id="reason" rows="3"
                                          class="hr-form-control"
                                          placeholder="Add a note for your manager…"></textarea>
                            </div>

                            <!-- Medical certificate (shown by JS when needed) -->
                            <div id="cert-section" style="display:none;">
                                <div class="hr-cert-divider">
                                    <label class="hr-form-label" for="medical_cert">
                                        Medical Certificate
                                        <span id="cert-required-star" class="required">*</span>
                                    </label>

                                    <label for="medical_cert" id="cert-dropzone"
                                           class="hr-cert-dropzone">
                                        <i class="fa fa-file-medical hr-cert-icon"/>
                                        <span id="cert-label-text" class="hr-cert-label">
                                            Click to upload or drag &amp; drop
                                        </span>
                                        <br/>
                                        <span class="hr-cert-hint">
                                            PDF, JPG or PNG · max 5 MB
                                        </span>
                                        <input type="file" name="medical_cert" id="medical_cert"
                                               accept=".pdf,.jpg,.jpeg,.png"
                                               style="display:none;"/>
                                    </label>

                                    <p id="cert-hint" class="hr-form-hint mt-2">
                                        <i class="fa fa-info-circle me-1"/>
                                        Required for Sick Leave of
                                        <t t-esc="cert_threshold"/>+ consecutive days.
                                        The certificate will be attached to your request.
                                    </p>
                                </div>
                            </div>

                            <!-- Submit -->
                            <button type="submit" class="hr-btn-request mb-0">
                                Submit Request
                            </button>
                        </form>

                        <a href="/my/allocations" class="hr-btn-cancel">Cancel</a>
                    </div>

                    <p class="hr-form-note">
                        <i class="fa fa-info-circle me-1"/>
                        Your request will be sent to HR for approval.
                        You'll see its status in <strong>Recent Requests</strong>.
                    </p>
                </t>

            </div>

            <script>
            (function () {
                var SICK_ID   = '<t t-esc="sl_id_str"/>';
                var THRESHOLD = parseInt('<t t-esc="cert_thresh"/>');

                var selType  = document.getElementById('leave_type_id');
                var inFrom   = document.getElementById('date_from');
                var inTo     = document.getElementById('date_to');
                var certSec  = document.getElementById('cert-section');
                var fileIn   = document.getElementById('medical_cert');
                var dropzone = document.getElementById('cert-dropzone');
                var lblText  = document.getElementById('cert-label-text');

                if (!selType) return;

                function calendarDays() {
                    if (!inFrom.value || !inTo.value) return 0;
                    var ms = new Date(inTo.value) - new Date(inFrom.value);
                    return Math.round(ms / 86400000) + 1;
                }

                function update() {
                    var isSick = selType.value === SICK_ID;
                    var days   = calendarDays();
                    var show   = isSick &amp;&amp; days >= THRESHOLD;
                    certSec.style.display = show ? '' : 'none';
                    fileIn.required = show;
                }

                selType.addEventListener('change', update);
                inFrom.addEventListener('change', function () {
                    if (!inTo.value || inTo.value &lt; this.value) inTo.value = this.value;
                    inTo.min = this.value;
                    update();
                });
                inTo.addEventListener('change', update);

                if (fileIn) {
                    fileIn.addEventListener('change', function () {
                        if (this.files.length) {
                            lblText.textContent = this.files[0].name;
                            dropzone.classList.add('active');
                        }
                    });
                }

                update();
            })();
            </script>
        </t>
    </template>

</odoo>
