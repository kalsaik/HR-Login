<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== Portal Home: HR Self-Service app grid ===== -->
    <template id="portal_my_home_allocations"
              name="Portal My Home: HR Self-Service"
              inherit_id="portal.portal_my_home">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <div class="mb-5">
                <p class="hr-section-label">HR Self-Service</p>
                <div class="row g-3">
                    <div class="col-4 col-sm-3 col-md-2">
                        <a href="/my/allocations" class="text-decoration-none d-block h-100">
                            <div class="hr-app-card">
                                <div class="hr-app-icon-bg">
                                    <i class="fa fa-calendar"/>
                                </div>
                                <span class="hr-app-label">Leave</span>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <!-- ===== /my/allocations — main Leave page ===== -->
    <template id="portal_my_allocations" name="My Leave Allocations">
        <t t-call="portal.portal_layout">
            <div class="hr-page">

                <!-- Success / cancelled banners -->
                <t t-if="success">
                    <div class="hr-alert hr-alert-success">
                        <i class="fa fa-check-circle"/>
                        Your leave request has been submitted and is pending approval.
                    </div>
                </t>
                <t t-if="request.params.get('cancelled')">
                    <div class="hr-alert hr-alert-info">
                        <i class="fa fa-info-circle"/>
                        Your leave request has been cancelled.
                    </div>
                </t>

                <!-- Greeting Banner -->
                <div class="hr-banner">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h3>Hi, <t t-esc="employee.name.split()[0] if employee else 'there'"/>!</h3>
                            <p class="hr-banner-sub">
                                <t t-if="employee and employee.job_title">
                                    <t t-esc="employee.job_title"/>
                                </t>
                                <t t-elif="employee and employee.department_id">
                                    <t t-esc="employee.department_id.name"/>
                                </t>
                                <t t-else="">Employee</t>
                            </p>
                        </div>
                        <t t-if="employee">
                            <div class="hr-banner-avatar">
                                <t t-esc="employee.name[0:1].upper()"/>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- Leave Balances -->
                <div class="hr-section-hd">
                    <span class="hr-section-hd-title">Leave Balances</span>
                    <span class="hr-section-hd-sub">Days remaining</span>
                </div>
                <div class="hr-card">
                    <t t-if="not employee or not allocations">
                        <div class="hr-empty">
                            <i class="fa fa-clipboard-o"/>
                            <p class="hr-empty-title">No allocations found</p>
                            <p class="hr-empty-sub">Contact HR to set up your leave entitlements.</p>
                        </div>
                    </t>
                    <t t-if="allocations">
                        <div class="row g-2">
                            <t t-foreach="allocations" t-as="alloc">
                                <t t-set="remaining"
                                   t-value="alloc.number_of_days - alloc.leaves_taken"/>
                                <t t-set="pending_days"
                                   t-value="pending_by_type.get(alloc.holiday_status_id.id, 0)"/>
                                <div class="col-6 col-sm-4">
                                    <div class="hr-alloc-block"
                                         t-att-title="alloc.holiday_status_id.name">
                                        <div class="hr-alloc-name">
                                            <t t-esc="alloc.holiday_status_id.name"/>
                                        </div>
                                        <div class="hr-alloc-days">
                                            <t t-esc="'%.0f' % remaining"/>
                                        </div>
                                        <div class="hr-alloc-unit">days</div>
                                        <div class="hr-alloc-sub">
                                            <span class="p">
                                                <t t-esc="'%.0f' % pending_days"/> pending
                                            </span>
                                            <span class="hr-alloc-sep">·</span>
                                            <span class="u">
                                                <t t-esc="'%.0f' % alloc.leaves_taken"/> used
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </t>
                </div>

                <!-- Request Leave button -->
                <a href="/my/leaves/new" class="hr-btn-request">
                    + Request Leave
                </a>

                <!-- Recent Requests -->
                <div class="hr-section-hd">
                    <span class="hr-section-hd-title">Recent Requests</span>
                    <a href="#" class="hr-section-hd-sub">View all →</a>
                </div>
                <div class="hr-card">
                    <t t-if="not recent_leaves">
                        <div class="hr-empty">
                            <i class="fa fa-inbox"/>
                            <p class="hr-empty-title">No requests yet</p>
                            <p class="hr-empty-sub">
                                Tap <strong>Request Leave</strong> above to submit your first request.
                            </p>
                        </div>
                    </t>
                    <t t-if="recent_leaves">
                        <t t-foreach="recent_leaves" t-as="leave">
                            <a t-attf-href="/my/leaves/#{leave.id}" class="hr-leave-row">
                                <div class="flex-grow-1 me-3 overflow-hidden">
                                    <div class="hr-leave-type-name text-truncate">
                                        <t t-esc="leave.holiday_status_id.name"/>
                                    </div>
                                    <div class="hr-leave-meta">
                                        <t t-esc="leave.date_from" t-options='{"widget":"date"}'/>
                                        <span class="mx-1">→</span>
                                        <t t-esc="leave.date_to"   t-options='{"widget":"date"}'/>
                                        <span class="ms-1">
                                            (<t t-esc="'%.0f' % leave.number_of_days"/>d)
                                        </span>
                                    </div>
                                </div>
                                <div class="flex-shrink-0 d-flex align-items-center gap-2">
                                    <t t-if="leave.state == 'validate'">
                                        <span class="hr-badge hr-badge-approved">Approved</span>
                                    </t>
                                    <t t-elif="leave.state in ('confirm', 'validate1')">
                                        <span class="hr-badge hr-badge-pending">Pending</span>
                                    </t>
                                    <t t-elif="leave.state == 'refuse'">
                                        <span class="hr-badge hr-badge-refused">Refused</span>
                                    </t>
                                    <t t-else="">
                                        <span class="hr-badge hr-badge-draft">Draft</span>
                                    </t>
                                    <i class="fa fa-chevron-right hr-row-arrow"/>
                                </div>
                            </a>
                        </t>
                    </t>
                </div>

            </div>
        </t>
    </template>

    <!-- ===== /my/leaves/<id> — Leave Detail ===== -->
    <template id="portal_leave_detail" name="Leave Request Detail">
        <t t-call="portal.portal_layout">
            <div class="hr-page">

                <!-- Banner -->
                <div class="hr-banner">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <a href="/my/allocations" class="hr-banner-back">
                                <i class="fa fa-arrow-left me-1"/>Back to Leave
                            </a>
                            <h3 class="mb-1">
                                <t t-esc="leave.holiday_status_id.name"/>
                            </h3>
                            <div>
                                <t t-if="leave.state == 'validate'">
                                    <span class="hr-badge hr-badge-approved">Approved</span>
                                </t>
                                <t t-elif="leave.state in ('confirm', 'validate1')">
                                    <span class="hr-badge hr-badge-pending">Pending Approval</span>
                                </t>
                                <t t-elif="leave.state == 'refuse'">
                                    <span class="hr-badge hr-badge-refused">Refused / Cancelled</span>
                                </t>
                                <t t-else="">
                                    <span class="hr-badge hr-badge-draft">Draft</span>
                                </t>
                            </div>
                        </div>
                        <div class="hr-banner-avatar">
                            <t t-esc="employee.name[0:1].upper()"/>
                        </div>
                    </div>
                </div>

                <!-- Details card -->
                <div class="hr-card">
                    <p class="hr-detail-section-title">Request Details</p>

                    <div class="hr-detail-row">
                        <span class="hr-detail-label">From</span>
                        <span class="hr-detail-value">
                            <t t-esc="leave.date_from" t-options='{"widget":"date"}'/>
                        </span>
                    </div>
                    <div class="hr-detail-row">
                        <span class="hr-detail-label">To</span>
                        <span class="hr-detail-value">
                            <t t-esc="leave.date_to" t-options='{"widget":"date"}'/>
                        </span>
                    </div>
                    <div class="hr-detail-row">
                        <span class="hr-detail-label">Duration</span>
                        <span class="hr-detail-value">
                            <t t-esc="'%.0f' % leave.number_of_days"/> working day(s)
                        </span>
                    </div>
                    <t t-if="leave.name">
                        <div class="hr-detail-row">
                            <span class="hr-detail-label">Reason</span>
                            <span class="hr-detail-value">
                                <t t-esc="leave.name"/>
                            </span>
                        </div>
                    </t>
                    <div class="hr-detail-row" style="border-bottom:none;">
                        <span class="hr-detail-label">Submitted</span>
                        <span class="hr-detail-value">
                            <t t-esc="leave.create_date" t-options='{"widget":"date"}'/>
                        </span>
                    </div>
                </div>

                <!-- Attachments card -->
                <t t-if="attachments">
                    <div class="hr-card">
                        <p class="hr-detail-section-title">Attachments</p>
                        <t t-foreach="attachments" t-as="att">
                            <a t-attf-href="/web/content/#{att.id}?download=true"
                               class="hr-attachment-row" target="_blank">
                                <i class="fa fa-file-o me-2"/>
                                <span class="flex-grow-1 text-truncate">
                                    <t t-esc="att.name"/>
                                </span>
                                <i class="fa fa-download ms-2"/>
                            </a>
                        </t>
                    </div>
                </t>

                <!-- Activity / chatter summary -->
                <t t-if="messages">
                    <div class="hr-card">
                        <p class="hr-detail-section-title">Activity</p>
                        <t t-foreach="messages" t-as="msg">
                            <div class="hr-message-row">
                                <div class="hr-message-avatar">
                                    <t t-esc="(msg.author_id.name or '?')[0:1].upper()"/>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="hr-message-author">
                                        <t t-esc="msg.author_id.name or 'System'"/>
                                        <span class="hr-message-date">
                                            <t t-esc="msg.date" t-options='{"widget":"date"}'/>
                                        </span>
                                    </div>
                                    <div class="hr-message-body" t-out="msg.body"/>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>

                <!-- Cancel button -->
                <t t-if="can_cancel">
                    <form t-attf-action="/my/leaves/#{leave.id}/cancel" method="post">
                        <input type="hidden" name="csrf_token"
                               t-att-value="request.csrf_token()"/>
                        <button type="submit" class="hr-btn-cancel-request"
                                onclick="return confirm('Are you sure you want to cancel this leave request?')">
                            <i class="fa fa-times me-1"/>Cancel This Request
                        </button>
                    </form>
                </t>

            </div>
        </t>
    </template>

    <!-- ===== /my/leaves/new — Leave Request Form ===== -->
    <template id="portal_leave_new" name="New Leave Request">
        <t t-call="portal.portal_layout">
            <div class="hr-page">

                <!-- Banner with back link -->
                <div class="hr-banner">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <a href="/my/allocations" class="hr-banner-back">
                                <i class="fa fa-arrow-left me-1"/>Back to Leave
                            </a>
                            <h3 class="mb-0">New Leave Request</h3>
                        </div>
                        <t t-if="employee">
                            <div class="hr-banner-avatar">
                                <t t-esc="employee.name[0:1].upper()"/>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- Error banner -->
                <t t-if="error">
                    <div class="hr-alert hr-alert-error">
                        <i class="fa fa-exclamation-circle"/>
                        <t t-esc="error"/>
                    </div>
                </t>

                <!-- No leave types available -->
                <t t-if="not leave_types_data">
                    <div class="hr-card">
                        <div class="hr-empty">
                            <i class="fa fa-clipboard-o"/>
                            <p class="hr-empty-title">No leave types available</p>
                            <p class="hr-empty-sub">
                                You don't have any approved allocations. Please contact HR.
                            </p>
                        </div>
                    </div>
                    <a href="/my/allocations" class="hr-btn-request">
                        Back to Leave Overview
                    </a>
                </t>

                <!-- Request form -->
                <t t-if="leave_types_data">

                    <t t-set="sl_id_str"   t-value="str(sick_leave_id)"/>
                    <t t-set="cert_thresh" t-value="str(cert_threshold)"/>

                    <div class="hr-card">
                        <form method="post" action="/my/leaves/new"
                              enctype="multipart/form-data">
                            <input type="hidden" name="csrf_token"
                                   t-att-value="request.csrf_token()"/>

                            <!-- Leave Type -->
                            <div class="hr-form-group">
                                <label class="hr-form-label" for="leave_type_id">
                                    Leave Type <span class="required">*</span>
                                </label>
                                <select name="leave_type_id" id="leave_type_id"
                                        class="hr-form-control hr-form-select"
                                        required="required">
                                    <option value="">— Select leave type —</option>
                                    <t t-foreach="leave_types_data" t-as="lt">
                                        <option t-att-value="lt['id']"
                                                t-att-selected="form_leave_type_id == lt['id']">
                                            <t t-esc="lt['name']"/>
                                            — <t t-esc="'%.1f' % lt['remaining']"/> days left
                                        </option>
                                    </t>
                                </select>
                            </div>

                            <!-- Date range + day counter -->
                            <div class="hr-form-group">
                                <div class="row g-2 align-items-end">
                                    <div class="col">
                                        <label class="hr-form-label" for="date_from">
                                            From <span class="required">*</span>
                                        </label>
                                        <input type="date" name="date_from" id="date_from"
                                               class="hr-form-control"
                                               t-att-value="form_date_from"
                                               required="required"/>
                                    </div>
                                    <div class="col">
                                        <label class="hr-form-label" for="date_to">
                                            To <span class="required">*</span>
                                        </label>
                                        <input type="date" name="date_to" id="date_to"
                                               class="hr-form-control"
                                               t-att-value="form_date_to"
                                               required="required"/>
                                    </div>
                                    <!-- Day counter box -->
                                    <div class="col-auto">
                                        <div id="day-counter" class="hr-day-counter">
                                            <div id="day-count-num" class="hr-day-counter-num">0</div>
                                            <div class="hr-day-counter-label">days</div>
                                        </div>
                                    </div>
                                </div>
                                <!-- Holiday / weekend note -->
                                <div id="date-note" class="hr-date-note" style="display:none;">
                                    <span id="date-note-text"></span>
                                </div>
                            </div>

                            <!-- Reason -->
                            <div class="hr-form-group">
                                <label class="hr-form-label" for="reason">
                                    Reason <span class="optional">(optional)</span>
                                </label>
                                <textarea name="reason" id="reason" rows="3"
                                          class="hr-form-control"
                                          placeholder="Add a note for your manager…"></textarea>
                            </div>

                            <!-- Covering Person -->
                            <t t-if="colleagues">
                                <div class="hr-form-group">
                                    <label class="hr-form-label" for="covering_person_id">
                                        Covering Person <span class="optional">(optional)</span>
                                    </label>
                                    <select name="covering_person_id" id="covering_person_id"
                                            class="hr-form-control hr-form-select">
                                        <option value="">— Select a colleague —</option>
                                        <t t-foreach="colleagues" t-as="col">
                                            <option t-att-value="col.id">
                                                <t t-esc="col.name"/>
                                                <t t-if="col.job_title"> — <t t-esc="col.job_title"/></t>
                                            </option>
                                        </t>
                                    </select>
                                    <p class="hr-form-hint">
                                        The colleague covering your responsibilities while you're away.
                                    </p>
                                </div>
                            </t>

                            <!-- Medical certificate (shown by JS when needed) -->
                            <div id="cert-section" style="display:none;">
                                <div class="hr-cert-divider">
                                    <label class="hr-form-label" for="medical_cert">
                                        Medical Certificate <span class="required">*</span>
                                    </label>
                                    <label for="medical_cert" id="cert-dropzone"
                                           class="hr-cert-dropzone">
                                        <i class="fa fa-file-medical hr-cert-icon"/>
                                        <span id="cert-label-text" class="hr-cert-label">
                                            Click to upload or drag &amp; drop
                                        </span>
                                        <br/>
                                        <span class="hr-cert-hint">PDF, JPG or PNG · max 5 MB</span>
                                        <input type="file" name="medical_cert" id="medical_cert"
                                               accept=".pdf,.jpg,.jpeg,.png"
                                               style="display:none;"/>
                                    </label>
                                    <p class="hr-form-hint mt-2">
                                        <i class="fa fa-info-circle me-1"/>
                                        Required for <t t-esc="cert_threshold"/>+ consecutive days of Sick Leave.
                                    </p>
                                </div>
                            </div>

                            <!-- Submit -->
                            <button type="submit" class="hr-btn-request mb-0">
                                Submit Request
                            </button>
                        </form>

                        <a href="/my/allocations" class="hr-btn-cancel">Cancel</a>
                    </div>

                    <p class="hr-form-note">
                        <i class="fa fa-info-circle me-1"/>
                        Your request will be sent to HR for approval.
                        You'll see its status in <strong>Recent Requests</strong>.
                    </p>
                </t>

            </div>

            <script>
            (function () {
                var SICK_ID   = '<t t-esc="sl_id_str"/>';
                var THRESHOLD = parseInt('<t t-esc="cert_thresh"/>');
                var HOLIDAYS  = <t t-out="holiday_dates_json"/>;

                var selType  = document.getElementById('leave_type_id');
                var inFrom   = document.getElementById('date_from');
                var inTo     = document.getElementById('date_to');
                var certSec  = document.getElementById('cert-section');
                var fileIn   = document.getElementById('medical_cert');
                var dropzone = document.getElementById('cert-dropzone');
                var lblText  = document.getElementById('cert-label-text');
                var countNum = document.getElementById('day-count-num');
                var dateNote = document.getElementById('date-note');
                var noteText = document.getElementById('date-note-text');

                if (!selType) return;

                /* ── helpers ── */
                function dateRange() {
                    if (!inFrom.value || !inTo.value) return [];
                    var dates = [], cur = new Date(inFrom.value), end = new Date(inTo.value);
                    while (cur &lt;= end) {
                        dates.push(cur.toISOString().slice(0, 10));
                        cur.setDate(cur.getDate() + 1);
                    }
                    return dates;
                }

                /* ── day counter ── */
                function updateCounter() {
                    var range  = dateRange();
                    if (!range.length) { countNum.textContent = '0'; dateNote.style.display = 'none'; return; }

                    var wkends = range.filter(function(d) {
                        var day = new Date(d).getUTCDay(); return day === 0 || day === 6;
                    }).length;
                    var holNames = range.filter(function(d) { return HOLIDAYS[d]; })
                                       .map(function(d) { return HOLIDAYS[d]; });
                    var workdays = range.length - wkends - range.filter(function(d) {
                        var day = new Date(d).getUTCDay();
                        return HOLIDAYS[d] &amp;&amp; day !== 0 &amp;&amp; day !== 6;
                    }).length;

                    countNum.textContent = workdays;

                    var notes = [];
                    if (wkends) notes.push(wkends + ' weekend day' + (wkends > 1 ? 's' : '') + ' excluded');
                    if (holNames.length) {
                        var names = holNames.slice(0, 2).join(', ') + (holNames.length > 2 ? ' +' + (holNames.length - 2) + ' more' : '');
                        notes.push('public holiday: ' + names);
                    }
                    if (notes.length) {
                        noteText.textContent = '📅 ' + notes.join(' · ');
                        dateNote.style.display = '';
                    } else {
                        dateNote.style.display = 'none';
                    }
                }

                /* ── cert section ── */
                function updateCert() {
                    var isSick = selType.value === SICK_ID;
                    var cal    = dateRange().length;
                    var show   = isSick &amp;&amp; cal >= THRESHOLD;
                    certSec.style.display = show ? '' : 'none';
                    if (fileIn) fileIn.required = show;
                }

                /* ── events ── */
                selType.addEventListener('change', updateCert);

                inFrom.addEventListener('change', function () {
                    if (!inTo.value || inTo.value &lt; this.value) inTo.value = this.value;
                    inTo.min = this.value;
                    updateCounter();
                    updateCert();
                });

                inTo.addEventListener('change', function () {
                    updateCounter();
                    updateCert();
                });

                if (fileIn) {
                    fileIn.addEventListener('change', function () {
                        if (this.files.length) {
                            lblText.textContent = this.files[0].name;
                            dropzone.classList.add('active');
                        }
                    });
                }

                updateCounter();
                updateCert();
            })();
            </script>
        </t>
    </template>

</odoo>
